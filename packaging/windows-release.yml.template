name: Windows portable build
on:
  workflow_dispatch:
  pull_request:
  push:
    branches: [main, ui-improvements]
    tags: ['v*']
permissions:
  contents: read
jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
          cache-dependency-path: packaging/requirements-build.txt
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Install build dependencies
        run: python -m pip install -r packaging/requirements-build.txt
      - name: Build current backend
        run: cargo build --release --locked
      - name: Core behavior checks
        run: |
          python -m unittest discover -s tests -p test_hybrid_fusion.py
          python -m unittest discover -s tests -p test_realtime_fusion.py
          python -m unittest discover -s tests -p test_windows_package.py
      - name: Install pinned vision models
        run: python tools/download_vision_models.py
      - name: Package Windows app
        run: python tools/build_windows.py --work build/windows --output dist
      - name: Frozen app self test
        shell: pwsh
        run: |
          $env:AETHER_DATA_DIR=Join-Path $env:RUNNER_TEMP 'aetherpose-selftest'
          $result=Join-Path $PWD 'dist/self-test.json'
          $process=Start-Process -FilePath 'build/windows/dist/AetherPose/AetherPose.exe' -ArgumentList @('--self-test','--report',"`"$result`"") -WindowStyle Hidden -Wait -PassThru
          if($process.ExitCode -ne 0){ if(Test-Path $result){Get-Content $result}; throw 'Frozen app self-test failed' }
          if(-not ((Get-Content $result -Raw | ConvertFrom-Json).passed)){throw 'Invalid self-test result'}
      - uses: actions/upload-artifact@v4
        with:
          name: AetherPose-windows-x64
          path: dist/*
  release:
    if: startsWith(github.ref, 'refs/tags/v')
    needs: build
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: AetherPose-windows-x64
          path: dist
      - name: Publish tested preview
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
          RELEASE_TAG: ${{ github.ref_name }}
        run: gh release create "$RELEASE_TAG" dist/* --title "AetherPose $RELEASE_TAG — Windows" --prerelease --generate-notes
